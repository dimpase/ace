#!/bin/sh
set -e

echo "TeXing documentation"
# Remove old outputs so a failed build cannot leave a stale manual.
for ext in aux bbl blg dvi idx ilg ind lab log pdf ps six toc; do
    rm -f "manual.$ext"
done

xetex -interaction=nonstopmode -halt-on-error manual
bibtex manual
xetex -interaction=nonstopmode -halt-on-error manual
sh ../../../doc/manualindex manual
xetex -interaction=nonstopmode -halt-on-error manual
xetex -interaction=nonstopmode -halt-on-error manual

mkdir -p ../htm
echo "Creating HTML documentation"
perl ../../../etc/convert.pl -i -u -c -n ACE . ../htm

make -C ../standalone-doc
cp ../standalone-doc/ace41.pdf .
